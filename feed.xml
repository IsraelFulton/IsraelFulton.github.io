---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
{% assign entries = site.projects | concat: site.posts | concat: site.data.writing | where_exp: "entry", "entry.kind != 'site-note'" | where_exp: "entry", "entry.draft != true" | where_exp: "entry", "entry.published != false" | sort_natural: "date" | reverse %}
{% assign latest_timestamp = 0 %}
{% for entry in entries %}
  {% assign entry_updated = entry.last_modified_at | default: entry.date %}
  {% assign timestamp = entry_updated | date: '%s' | plus: 0 %}
  {% if timestamp > latest_timestamp %}
    {% assign latest_timestamp = timestamp %}
    {% assign latest_updated = entry_updated %}
  {% endif %}
{% endfor %}
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang | xml_escape }}">
  <title>{{ site.title | xml_escape }} — Writing and Research</title>
  <subtitle>{{ site.description | strip | xml_escape }}</subtitle>
  <id>{{ '/feed.xml' | absolute_url | xml_escape }}</id>
  <link href="{{ '/feed.xml' | absolute_url | xml_escape }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/' | absolute_url | xml_escape }}" rel="alternate" type="text/html" />
  <updated>{{ latest_updated | date_to_xmlschema }}</updated>
  <author>
    <name>{{ site.social.name | xml_escape }}</name>
    <uri>{{ '/' | absolute_url | xml_escape }}</uri>
  </author>
  {% for entry in entries %}
  <entry>
    <title>{{ entry.title | strip_html | xml_escape }}</title>
    <id>{{ entry.url | absolute_url | xml_escape }}</id>
    <link href="{{ entry.url | absolute_url | xml_escape }}" rel="alternate" type="text/html" />
    <published>{{ entry.date | date_to_xmlschema }}</published>
    <updated>{{ entry.last_modified_at | default: entry.date | date_to_xmlschema }}</updated>
    <summary type="text">{{ entry.summary | default: entry.excerpt | strip_html | normalize_whitespace | xml_escape }}</summary>
  </entry>
  {% endfor %}
</feed>
